[gd_resource type="Resource" script_class="UpgradeTree" format=3]

[ext_resource type="Script" path="res://data/upgrade_node.gd" id="1_dg0cv"]
[ext_resource type="Script" path="res://data/upgrade_tree.gd" id="2_ingv1"]

[sub_resource type="Resource" id="Resource_ubjoy"]
script = ExtResource("1_dg0cv")
id = "scout_drone"
display_name = "Scout Drone"
description = "Unlocks the drone for scouting ahead."
effects = {
"drone_unlocked": 1.0
}

[sub_resource type="Resource" id="Resource_kbxlx"]
script = ExtResource("1_dg0cv")
id = "quiet_rotors"
display_name = "Quiet Rotors"
description = "The drone makes much less noise."
requires = Array[String](["scout_drone"])
effects = {
"drone_noise": -30.0
}

[sub_resource type="Resource" id="Resource_yebht"]
script = ExtResource("1_dg0cv")
id = "fast_rotors"
display_name = "Fast Rotors"
description = "The drone flies faster."
requires = Array[String](["scout_drone"])
effects = {
"drone_speed": 40.0
}

[resource]
script = ExtResource("2_ingv1")
device_id = "drone"
display_name = "Drone"
base_stats = {
"drone_noise": 40.0,
"drone_speed": 60.0,
"drone_unlocked": 0.0
}
nodes = Array[ExtResource("1_dg0cv")]([SubResource("Resource_ubjoy"), SubResource("Resource_kbxlx"), SubResource("Resource_yebht")])
